{
  "name": "echocue-client",
  "version": "0.1.0",
  "private": true,
  "description": "Electron client for Douyin-EchoCue.",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test:contract": "node --experimental-strip-types --test tests/protocol.test.ts",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build": "npm run clean && npm run build:electron && npm run build:renderer",
    "dev": "npm run build:electron && concurrently --kill-others-on-fail \"vite\" \"tsc -p tsconfig.electron.json --watch\" \"wait-on http://localhost:5173 && electron .\"",
    "package:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@fontsource/noto-sans-sc": "^5.2.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.1.2",
    "electron": "^36.9.5",
    "electron-builder": "^26.15.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.echocue.client",
    "productName": "EchoCue Client",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
