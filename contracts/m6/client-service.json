{
  "schemaVersion": 1,
  "httpEndpoints": [
    {"method": "POST", "path": "/client/session", "operationId": "client:create-session"},
    {"method": "DELETE", "path": "/client/session", "operationId": "client:delete-session"},
    {"method": "GET", "path": "/client/me", "operationId": "client:me"},
    {"method": "GET", "path": "/client/rooms", "operationId": "client:list-rooms"},
    {"method": "POST", "path": "/client/runtimes", "operationId": "client:create-runtime"},
    {
      "method": "DELETE",
      "path": "/client/runtimes/{runtime_id}",
      "operationId": "client:delete-runtime"
    },
    {
      "method": "POST",
      "path": "/client/remediation-links",
      "operationId": "client:create-remediation-link"
    },
    {"method": "POST", "path": "/webui/session", "operationId": "webui:create-session"},
    {"method": "DELETE", "path": "/webui/session", "operationId": "webui:delete-session"},
    {"method": "GET", "path": "/webui/me", "operationId": "webui:me"},
    {"method": "GET", "path": "/webui/rooms", "operationId": "webui:list-rooms"},
    {
      "method": "POST",
      "path": "/webui/remediation-token-consumptions",
      "operationId": "webui:create-remediation-token-consumption"
    }
  ],
  "websocketEndpoint": {
    "path": "/client/runtime/ws/{client_id}/{room_id}/{runtime_id}"
  },
  "errorCodes": {
    "retryable": ["roomOffline", "douyinliveUnavailable", "runtimeStartFailed"],
    "remediation": ["personaNotPublished", "ruleConflict"],
    "blocked": [
      "unauthenticated",
      "clientSessionConflict",
      "permissionDenied",
      "clientRuntimeActive",
      "roomActiveByOtherClient"
    ]
  },
  "httpExamples": {
