          "roomId": "516466932480",
          "status": "starting",
          "ws": {
            "url": "ws://127.0.0.1:8000/client/runtime/ws/9f3f0c45-8f2a-4cc1-9f7f-2f71ef7cd101/516466932480/run_20260820_001",
            "heartbeatIntervalSeconds": 10,
            "heartbeatTimeoutSeconds": 30,
            "connectRetryWindowSeconds": 30
          }
        }
      }
    },
    "runtimeStopSuccess": {
      "response": {
        "code": 200,
