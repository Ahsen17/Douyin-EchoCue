      },
      "response": {
        "code": 200,
        "message": "ok",
        "data": {
          "url": "https://webui.example.com/remediation?token=fake_one_time_token",
          "expiresIn": 900
        }
      }
    },
    "remediationTokenConsumptionSuccess": {
      "request": {"token": "fake_one_time_token"},
      "response": {
        "code": 200,
        "message": "ok",
        "data": {
          "roomId": "516466932480",
          "issueType": "persona",
          "route": "/rooms/{roomId}/persona",
          "params": {"roomId": "516466932480"},
          "expiresAt": "2026-08-20T10:15:00Z"
        }
      }
    },
    "blockedFailure": {
      "response": {
        "code": 409,
        "message": "permission denied",
        "data": {
          "errorCode": "permissionDenied",
          "message": "The current account cannot start this room"
        }
      }
    },
    "retryableFailure": {
      "response": {
        "code": 409,
        "message": "room is not live",
        "data": {
          "errorCode": "roomOffline",
          "message": "The room is offline",
          "retryable": true
        }
      }
    },
    "remediationFailure": {
      "response": {
        "code": 409,
        "message": "persona not published",
        "data": {
          "errorCode": "personaNotPublished",
          "message": "A published room persona is required",
          "remediation": {
            "issueType": "persona",
            "route": "/rooms/{roomId}/persona",
            "params": {"roomId": "516466932480"},
            "requiresOneTimeToken": true
          }
        }
      }
    }
  },
